# HTTPS automático (Let's Encrypt) para el dominio configurado en DOMAIN.
{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:3000
}

# Quien entre por la IP directa se redirige al dominio con HTTPS.
http:// {
	redir https://{$DOMAIN}{uri} permanent
}

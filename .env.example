# Copia este archivo a .env.local para desarrollo.
# MongoDB (la base de datos es la del path: /weddingplanner)
MONGODB_URI=mongodb://localhost:27017/weddingplanner?replicaSet=rs0&directConnection=true

# Better Auth — genera el secret con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Administrador inicial (se crea al arrancar si todavía no existe ningún admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// Documento singleton: datos generales de la boda.
model Wedding {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  partner1     String    @default("")
  partner2     String    @default("")
  weddingDate  DateTime?
  venueName    String    @default("")
  venueAddress String    @default("")
  currency     String    @default("HNL")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Conexión OAuth con el Google Drive de la persona (singleton, igual patrón que Wedding).
// El access/refresh token permiten subir fotos y videos a una carpeta dedicada en su Drive.
model GoogleDriveConnection {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  weddingId    String?   @db.ObjectId
  accountEmail String    @default("")
  accessToken  String
  refreshToken String
  expiryDate   DateTime?
  folderId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Foto, video, mapa o link de referencia para la boda (ej. fotos del local, video de
// inspiración, ubicación en Google Maps). Si hay una GoogleDriveConnection, los archivos
// subidos van a una carpeta del Drive de la persona; si no, se guardan localmente.
model MediaItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  weddingId   String?  @db.ObjectId
  // image | video | map | link
  type        String   @default("link")
  url         String
  driveFileId String?
  label       String   @default("")
  notes       String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Grupo familiar/social de invitados (ej. "Familia del novio", "Amigos de la novia"),
// gestionado en Configuración. Igual que Vendor/Account: solo alimenta las sugerencias del
// campo "Grupo" en el formulario de invitados, Guest.group sigue siendo texto libre.
model GuestGroup {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  weddingId String?  @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guest {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  weddingId           String?  @db.ObjectId
  fullName            String
  group               String   @default("")
  rsvpStatus          String   @default("pending") // pending | confirmed | declined
  plusOnes            Int      @default(0)
  plusOneNames        String[] @default([])
  dietaryRestrictions String   @default("")
  notes               String   @default("")
  // Referencia suelta al id de un LayoutElement embebido en SeatingLayout.elements.
  tableElementId      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ExpenseCategory {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  weddingId       String?  @db.ObjectId
  name            String
  estimatedBudget Float    @default(0)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Directorio de proveedores, gestionado en Configuración. Expense.vendor sigue siendo texto
// libre (no una relación) para no romper gastos existentes; este modelo solo alimenta las
// sugerencias del campo "Proveedor" en el formulario de gastos.
model Vendor {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  weddingId   String?  @db.ObjectId
  name        String
  contactName String   @default("")
  phone       String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Expense {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  weddingId       String?   @db.ObjectId
  categoryId      String    @db.ObjectId
  description     String
  vendor          String    @default("")
  estimatedAmount Float     @default(0)
  actualAmount    Float     @default(0)
  amountPaid      Float     @default(0)
  paymentStatus   String    @default("pending") // pending | partially_paid | paid
  dueDate         DateTime?
  paidDate        DateTime?
  notes           String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Aporte de dinero de una persona (novio, novia, papás, etc.) hacia el presupuesto de la boda.
// El presupuesto total se calcula como la suma de estos aportes (ver BudgetSummary).
model BudgetContribution {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  weddingId   String?   @db.ObjectId
  // groom | bride | groom_parents | bride_parents | other
  contributor String    @default("other")
  // Solo se usa cuando contributor = "other".
  otherLabel  String    @default("")
  amount      Float     @default(0)
  date        DateTime?
  notes       String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Cuenta/fuente de dinero desde la que se pagan los gastos (ej. "Cuenta de ahorros",
// "Efectivo"), gestionada en Configuración. Igual que Vendor: solo alimenta el selector de
// ExpensePayment, no es una relación estricta.
model Account {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  weddingId String?  @db.ObjectId
  name      String
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Un pago individual hecho hacia un Expense — permite registrar abonos/cuotas por
// separado (en vez de un solo "amountPaid") y adjuntar el comprobante de cada uno.
// Expense.amountPaid se recalcula automáticamente como la suma de estos pagos.
model ExpensePayment {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  expenseId   String    @db.ObjectId
  // Referencia suelta a Account.id — de qué cuenta salió el dinero. Null = sin especificar.
  accountId   String?   @db.ObjectId
  amount      Float     @default(0)
  date        DateTime?
  // Ruta pública del comprobante subido (ver src/app/gastos/payments-actions.ts), ej. "/uploads/receipts/xxx.jpg".
  receiptUrl  String    @default("")
  receiptName String    @default("")
  notes       String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Song {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  weddingId   String?  @db.ObjectId
  title       String
  artist      String   @default("")
  // ceremony | cocktail | entrance | dinner | party | last_dance | do_not_play | other
  category    String   @default("other")
  mustPlay    Boolean  @default(false)
  requestedBy String   @default("")
  notes       String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Un "evento" dentro de la boda (ej. "Boda Jardín", "Boda Fiesta") — permite tener
// varias líneas de tiempo independientes cuando la boda tiene más de una celebración.
model WeddingEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  weddingId String?  @db.ObjectId
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimelineEvent {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  weddingId       String?   @db.ObjectId
  // Referencia suelta a WeddingEvent.id. Null = "General" (boda sin sub-eventos separados).
  eventId         String?   @db.ObjectId
  title           String
  description     String    @default("")
  startTime       DateTime?
  durationMinutes Int       @default(0)
  // preparation | ceremony | reception | party
  category        String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Elemento embebido dentro de SeatingLayout.elements (mesa, silla, escenario, altar, entrada, etc.).
// El campo `id` es un string generado en la app (no un ObjectId de Mongo), y es lo que
// Guest.tableElementId referencia para asignar invitados a una mesa.
type LayoutElement {
  id          String
  // table-round | table-rectangular | table-sweetheart | table-cake | chair-row |
  // stage | dance-floor | photo-area | altar | aisle | entrance | restroom | hallway
  type        String
  label       String  @default("")
  tableNumber Int?
  x           Float
  y           Float
  width       Float
  height      Float
  rotation    Float   @default(0)
  capacity    Int?
  // Solo para type "chair-row": filas y columnas del bloque de sillas.
  rows        Int?
  columns     Int?
  fill        String?
  zIndex      Int     @default(0)
}

// Vértice del polígono que define el contorno del local (ver SeatingLayout.roomShape).
type RoomPoint {
  x Float
  y Float
}

// Distribución visual de un evento de la boda (una por WeddingEvent — comparten el mismo id
// que su WeddingEvent, ver getOrCreateSeatingLayout en lib/seatingLayout.ts).
model SeatingLayout {
  id           String          @id @map("_id") @db.ObjectId
  weddingId    String?         @db.ObjectId
  eventId      String?         @db.ObjectId
  canvasWidth  Int             @default(2000)
  canvasHeight Int             @default(1400)
  // indoor | garden — estilo visual del salón (interior o ceremonia al aire libre).
  background   String          @default("indoor")
  // Contorno del local (polígono). Vacío = sin definir, se muestra un rectángulo simple.
  roomShape    RoomPoint[]
  elements     LayoutElement[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// Registro de auditoría: inicios de sesión, cambios en los datos de cada boda y acciones
// de administración. Los índices (y el TTL de 180 días) se crean al arrancar, en
// lib/bootstrap.ts.
model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  // "<entidad>.<verbo>", ej. auth.sign_in, guest.create, admin.user_ban
  action     String
  // auth | data | admin
  category   String
  summary    String
  success    Boolean  @default(true)
  actorId    String?
  actorName  String   @default("")
  actorEmail String   @default("")
  weddingId  String?
  targetId   String?
  ip         String   @default("")
  userAgent  String   @default("")
  createdAt  DateTime @default(now())
}
